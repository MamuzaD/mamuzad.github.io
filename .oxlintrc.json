{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": ["typescript", "unicorn", "oxc", "react", "import", "jsx-a11y"],
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-unused-expressions": ["error", { "allowShortCircuit": true }]
  },
  "env": {
    "builtin": true
  }
}
