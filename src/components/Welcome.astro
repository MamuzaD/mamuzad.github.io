---
import GiraffeEgg from "@/components/GiraffeEgg"
import { LinkPreview } from "@/components/ui/link-preview"
---

<main data-welcome class="relative z-0 mx-auto mb-12 flex max-w-3xl flex-col items-start px-4 pt-60">
  <h1 class="font-display mb-5 leading-none font-black tracking-tight">
    <span
      data-welcome-intro
      class="block text-2xl font-extrabold md:text-3xl"
      style="opacity: 0; transform: translateY(40px);"
    >
      hey, i'm
    </span>
    <span
      data-welcome-name
      class="text-primary inline-flex items-center gap-4 text-6xl md:text-8xl"
      style="opacity: 0; transform: translateX(-200px);"
    >
      <span class="z-1">daniel</span>
      <GiraffeEgg client:load />
    </span>
  </h1>

  <h2
    data-welcome-subtitle
    class="text-muted-foreground max-w-sm text-lg md:text-xl"
    style="opacity: 0; transform: translateX(-20px);"
  >
    software engineer <span class="text-foreground font-bold">·</span> student at{" "}
    <LinkPreview
      noUrl
      imageSrc="/experiences/unlv.webp"
      height={80}
      width={80}
      isStatic
      className="text-muted-foreground dark:text-muted-foreground cursor-default"
      side="right"
      sideOffset={20}
      align="center"
      alignOffset={0}
      client:load
    >
      <span>unlv</span>
    </LinkPreview>
  </h2>
</main>

<script>
  import { animate, inView } from "motion"

  interface RevealOptions {
    selector: string
    transform: string
    transition: {
      delay: number
      stiffness: number
      damping: number
    }
  }

  let activeWelcome: HTMLElement | null = null
  let stopReveals: Array<() => void> = []

  function reveal(root: HTMLElement, { selector, transform, transition }: RevealOptions) {
    const element = root.querySelector<HTMLElement>(selector)
    if (!element) return () => {}

    return inView(element, () => {
      animate(element, { opacity: 1, transform }, { type: "spring", ...transition })
    })
  }

  function initializeWelcome() {
    const welcome = document.querySelector<HTMLElement>("[data-welcome]")
    if (welcome === activeWelcome) return

    stopReveals.forEach((stop) => stop())
    stopReveals = []
    activeWelcome = welcome

    if (!welcome) return

    stopReveals = [
      reveal(welcome, {
        selector: "[data-welcome-intro]",
        transform: "translateY(0px)",
        transition: { delay: 0.35, stiffness: 120, damping: 12 },
      }),
      reveal(welcome, {
        selector: "[data-welcome-name]",
        transform: "translateX(0px)",
        transition: { delay: 0.5, stiffness: 100, damping: 10 },
      }),
      reveal(welcome, {
        selector: "[data-welcome-subtitle]",
        transform: "translateX(0px)",
        transition: { delay: 0.98, stiffness: 100, damping: 10 },
      }),
    ]
  }

  initializeWelcome()
  document.addEventListener("astro:page-load", initializeWelcome)
</script>
